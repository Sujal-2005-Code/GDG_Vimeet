# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/gdg_vimeet

# Comma-separated list of allowed frontend origins (required in production
# for the admin login cookie to work — no wildcard/credentials combo exists).
# e.g. CORS_ORIGIN=https://gdgvimeet.vercel.app
CORS_ORIGIN=

# --- Admin panel authentication ---
# Username for the GDG ViMEET admin panel (organizers only).
ADMIN_USERNAME=

# Bcrypt hash of the admin password. Generate it with:
#   node scripts/hash-password.js "your-chosen-password"
# Never commit the plaintext password or this file with real values.
ADMIN_PASSWORD_HASH=

# Long random secret used to sign admin session tokens (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Applicant confirmation email (Brevo transactional API) ---
# WITHOUT BOTH OF THESE, APPLICATION CONFIRMATION EMAILS ARE SILENTLY SKIPPED
# (the backend logs "Brevo credentials not configured" and carries on).
# EMAIL_USER must be a sender address verified in your Brevo account.
BREVO_API_KEY=
EMAIL_USER=

PORT=3000
